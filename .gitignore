# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. The RTT token lives in .env.local and must never be committed:
# a token found in a distributable app gets revoked.
.env*
!.env.example

# vercel
.vercel

# machine-local editor/tool settings
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Generator response cache (see scripts/generate-stations.mjs). Safe to delete.
.rtt-cache/

# Progress and raw calling patterns for the adjacency walk. Large, rebuildable, and
# only meaningful alongside .rtt-cache/. The published artifact, data/adjacency.json,
# is committed; this is the scaffolding that produced it.
data/.adjacency-state.json

# Swift. `.build` is ~100MB of object files; `.swiftpm` and xcuserdata are
# per-machine editor state. All of it regenerates from `swift run`.
ios/.build/
ios/.swiftpm/
# xcodebuild's derived data when a build passes `-derivedDataPath build/...`.
ios/build/

# Generated from ios/project.yml by `xcodegen generate`, both of them. Committing the
# project would mean committing hand-unreadable XML full of UUIDs, and every change to
# it would be a merge conflict. The spec is the source of truth for both.
ios/LastTrain.xcodeproj/
ios/App/LastTrain/Info.plist
ios/App/Widget/Info.plist
# Entitlements too. The App Group is declared once in project.yml and written into both
# of these, which is the only way the two cannot drift apart.
ios/App/LastTrain/LastTrain.entitlements
ios/App/Widget/LastTrainWidget.entitlements
*.xcuserdatad
xcuserdata/
DerivedData/

# Agent tooling, installed into the repo rather than written for it. Roughly 72,000 lines
# of it, which is why this is here: `git add -A` swept the lot into a two-line commit
# about a request budget before anyone noticed.
.agents/
skills-lock.json
