{
  "name": "last-train",
  "version": "1.0.0",
  "private": true,
  "description": "First and last direct train between two stations on c2c, the Elizabeth line and the Liverpool Street to Shenfield corridor.",
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "spike": "node scripts/spike.mjs",
    "national": "node scripts/national.mjs",
    "national:data": "node scripts/generate-national.mjs",
    "stations": "node scripts/generate-stations.mjs",
    "test": "TZ=UTC node --conditions=react-server --test lib/*.test.ts",
    "national:adjacency": "node scripts/generate-adjacency.mjs --all --budget 900",
    "darwin:probe": "node scripts/darwin-probe.mjs",
    "darwin:parse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/darwin-parse.mjs",
    "darwin:board": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/darwin-board.mjs",
    "darwin:publish": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/darwin-publish.mjs"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1129.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "saxes": "^6.0.0",
    "typescript": "^5"
  }
}
