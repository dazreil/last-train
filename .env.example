# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# Credentials come from https://api-portal.rtt.io (needs an RTT unified login).
# The free tier is for personal, non-commercial use only.
#
# Set ONE of the two tokens below, depending on which you were issued. The portal
# makes clear which one you hold.

# A long-life access token, used as-is.
RTT_ACCESS_TOKEN=

# Or a long-life refresh token, which the server exchanges for short-life access
# tokens via /api/get_access_token and caches until they expire.
RTT_REFRESH_TOKEN=

# The API version to pin, as an ISO date. Leave as-is unless you have re-run the
# spike against a newer version: pinning is what stops a spec change silently
# altering response shapes. 2026-04-09 is the earliest version that serves
# /data/stops, which the station list is generated from.
RTT_API_VERSION=2026-04-09

# Darwin Live Departure Boards (LDBWS REST), from https://raildata.org.uk.
# Subscribe (free) to "Live Departure Board" and copy the Consumer key. Fast Train and
# the destinations list use this; Last Train stays on RTT. Sent as the `x-apikey` header.
DARWIN_LDBWS_KEY=

# Base up to (not including) the method. Requests append `/GetDepBoardWithDetails/{crs}`.
# From your subscription's Specification tab, e.g.
# https://api1.raildata.org.uk/1010-live-departure-board-dep1_2/LDBWS/api/20220120
DARWIN_LDBWS_BASE_URL=
